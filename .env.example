# Required production values. Generate fresh values before starting compose.yml.
# All first-party containers use the same release version.
AGENT_HUB_IMAGE_REGISTRY=ghcr.io/yiiilin
AGENT_HUB_IMAGE_TAG=0.4.4

POSTGRES_USER=agent_hub
POSTGRES_PASSWORD=
POSTGRES_DB=agent_hub
# Use the same URL-safe password as POSTGRES_PASSWORD.
# Example shape: postgres://agent_hub:<password>@postgres:5432/agent_hub
DATABASE_URL=

# `openssl rand -base64 32` produces a valid model key.
HUB_MODEL_SECRET_KEY=
# `openssl rand -hex 32` produces a suitable embed JWT secret.
EMBED_JWT_SECRET=
EMBED_JWT_ISSUER=agent-hub
EMBED_JWT_AUDIENCE=agent-hub-widget

# Dedicated credentials for the bundled, private MinIO service.
HUB_BUNDLE_S3_ACCESS_KEY_ID=
HUB_BUNDLE_S3_SECRET_ACCESS_KEY=
HUB_BUNDLE_S3_BUCKET=agent-hub-sessions
HUB_BUNDLE_S3_REGION=us-east-1
HUB_BUNDLE_S3_ENDPOINT=http://bundle-store:9000
HUB_BUNDLE_S3_ALLOW_HTTP=true
HUB_BUNDLE_S3_SERVER_SIDE_ENCRYPTION=
HUB_BUNDLE_S3_KMS_KEY_ID=
# Skill Package can share this S3-compatible store or use Hub-local storage.
HUB_SKILL_PACKAGE_STORAGE=s3
HUB_SKILL_PACKAGE_LOCAL_DIR=/var/lib/agent-hub/skill-packages

# The Hub web endpoint listens on loopback for a host reverse proxy by default.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080
SESSION_COOKIE_SECURE=true
# Leave empty to trust Forwarded/X-Forwarded-For from every peer. In production,
# set the comma-separated CIDRs of the reverse proxies that may supply them.
TRUSTED_PROXY_CIDRS=

# Optional co-located Runtime (`docker compose --profile runtime up -d`).
ENGINE_BIN=/opt/agent-hub/pi/pi
RUNTIME_ENGINE_VERSION=0.81.1
RUNTIME_ENROLLMENT_TOKEN=
RUNTIME_HOSTNAME=compose-runtime-1
RUNTIME_MAX_ONLINE_SESSIONS=4
RUNTIME_SESSION_IDLE_TIMEOUT_SECS=900
